<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FocusGateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GateActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.focusgate.gate"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FocusGate.Gate" />

        <activity
            android:name=".InterruptActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.focusgate.interrupt"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FocusGate.Gate" />

        <activity
            android:name=".dialog.ReminderDialogActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.focusgate.dialog"
            android:theme="@style/Theme.FocusGate.Dialog" />

        <activity
            android:name=".ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".HistoryReviewActivity"
            android:exported="false" />

        <!-- 核心检测服务：AccessibilityService -->
        <service
            android:name=".service.AccessibilityMonitorService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled accessibility app-blocking monitor responsive while protected apps are in the foreground" />
        </service>
    </application>
</manifest>
